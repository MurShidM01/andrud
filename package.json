{
  "name": "andrud",
  "version": "1.0.6",
  "description": "Modern Android & Kotlin Multiplatform project scaffolding CLI tool",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "andrud": "./bin/andrud.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./plugins/kotlin-multiplatform": {
      "types": "./dist/plugins/kotlin-multiplatform.d.ts",
      "default": "./dist/plugins/kotlin-multiplatform.js"
    }
  },
  "keywords": [
    "android",
    "cli",
    "scaffolding",
    "generator",
    "kotlin",
    "kotlin-multiplatform",
    "kmp",
    "compose-multiplatform",
    "cross-platform",
    "java",
    "jetpack-compose",
    "ndk",
    "native",
    "project-template",
    "android-studio",
    "mobile-development"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "build:all": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && node bin/andrud.js",
    "link": "npm run build && npm link",
    "test": "npm run build && node --test \"dist/__tests__/*.js\"",
    "prepublishOnly": "npm test"
  },
  "author": "MurShidM01",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurShidM01/andrud.git"
  },
  "homepage": "https://github.com/MurShidM01/andrud#readme",
  "bugs": {
    "url": "https://github.com/MurShidM01/andrud/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "cac": "^6.7.14",
    "fs-extra": "^11.2.0",
    "gradient-string": "^2.0.2",
    "ora": "^8.0.1",
    "picocolors": "^1.0.1",
    "update-notifier": "^7.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.12",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
